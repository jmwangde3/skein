#!/usr/bin/env bash
# skein-cli — Skein v2 外部单命令封装层
# 把多步机械核对、建库、老库迁移、写前留痕、接手汇总与 worktree 管理压成单条命令，
# 最大限度减少 Agent 的工具调用轮次与 token 消耗。

set -euo pipefail
shopt -s nullglob

VERSION="2.0.5"

die() { printf '[SKEIN_ERR] %s\n' "$*" >&2; exit 2; }
gap() { printf '[HANDOFF_GAP] %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

wp() {
  if command -v cygpath >/dev/null 2>&1; then
    cygpath -m "$1"
  else
    printf '%s' "$1"
  fi
}

hash8() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | cut -c1-8
  else
    shasum -a 256 | cut -c1-8
  fi
}

now_iso() {
  date '+%Y-%m-%dT%H:%M:%S%z' 2>/dev/null || date '+%Y-%m-%d %H:%M:%S'
}

find_scope() {
  local d p
  d="$(pwd -P)"
  while :; do
    if [ -f "$d/AGENTS.local.md" ]; then
      printf '%s' "$d"
      return 0
    fi
    p="$(dirname "$d")"
    [ "$p" = "$d" ] && return 1
    d="$p"
  done
}

kv() {
  local file="$1" key="$2" line val
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$line" in
      "${key}:"*)
        val="${line#${key}:}"
        val="${val#"${val%%[![:space:]]*}"}"
        val="${val%"${val##*[![:space:]]}"}"
        printf '%s' "$val"
        return 0
        ;;
    esac
  done < "$file"
  return 1
}

load_route() {
  SCOPE="$(find_scope || true)"
  [ -n "$SCOPE" ] || gap "未找到 AGENTS.local.md（应在工作区根）。请先挂载 skein-init 执行建库。"
  LOCAL="$SCOPE/AGENTS.local.md"
  DATA_DIR="$(kv "$LOCAL" data_dir || true)"
  CKPT="$(kv "$LOCAL" checkpoints || true)"
  KB="$(kv "$LOCAL" kb || true)"
  WT_ROOT="$(kv "$LOCAL" worktree_root || true)"
  BOARD="$(kv "$LOCAL" board || true)"
  GLOBAL_KB="$(kv "$LOCAL" global_kb || true)"
  [ -n "$CKPT" ] && [ -n "$KB" ] && [ -n "$WT_ROOT" ] || gap "$LOCAL 缺少必需键（checkpoints / kb / worktree_root）"
}

is_repo_root() {
  local dir="$1" top
  [ -e "$dir/.git" ] || return 1
  top="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || true)"
  [ -n "$top" ] || return 1
  [ "$(cd "$top" && pwd -P)" = "$(cd "$dir" && pwd -P)" ]
}

skip_dir() {
  case "$1" in
    node_modules|.venv|venv|dist|build|target|.git|.worktrees) return 0 ;;
    *) return 1 ;;
  esac
}

current_repo_info() {
  local origin configured_scope first
  BOUND_ID="$(kv "$LOCAL" worktree_task_id || true)"
  REPO="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -z "$REPO" ]; then
    REPO=""
    REPO_REL=""
    REPO_NAME="$(basename "$PWD")"
    return 0
  fi
  REPO="$(cd "$REPO" && pwd -P)"
  ORIGIN_REPO="$REPO"
  configured_scope="$SCOPE"
  if [ -f "$REPO/.git" ]; then
    # In a linked worktree SCOPE is the copied route, not the original workspace.
    IFS= read -r -d '' first < <(git -C "$REPO" worktree list --porcelain -z) || gap "无法定位主工作树"
    origin="${first#worktree }"
    ORIGIN_REPO="$(cd "$origin" && pwd -P)"
    configured_scope="$(kv "$LOCAL" scope || true)"
    configured_scope="$(cd "${configured_scope:-$SCOPE}" && pwd -P)" || gap "路由中的 scope 不存在"
  fi
  REPO_NAME="$(basename "$ORIGIN_REPO")"
  if [ "$ORIGIN_REPO" = "$configured_scope" ]; then
    REPO_REL="."
  else
    REPO_REL="${ORIGIN_REPO#"$configured_scope"/}"
  fi
}

# Resolve the administrative file for this specific worktree.
check_bg_writers() {
  local target="$1" lock
  lock="$(git -C "$target" rev-parse --path-format=absolute --git-path index.lock)" || return 1
  if [ -e "$lock" ]; then
    printf 'GIT_INDEX_LOCK: %s（请核查是否仍在运行，或是否为残留锁）' "$lock"
  fi
}

git_live_status() {
  local repo="$1" py="" status_text
  if command -v python3 >/dev/null 2>&1; then py=python3
  elif command -v python >/dev/null 2>&1; then py=python; fi
  if [ -n "$py" ] && PYTHONIOENCODING=utf-8:backslashreplace "$py" - "$(wp "$repo")" <<'PY'
import os
import subprocess
import sys
import time

root = sys.argv[1]
raw = subprocess.check_output(["git", "-C", root, "status", "--porcelain=v1", "-z",
                               "--untracked-files=normal"])
if not raw:
    print("status: clean")
    sys.exit(0)

def sample(path):
    try:
        st = os.lstat(os.path.join(root, path))
        return st.st_mtime_ns, st.st_size
    except OSError:
        return None

def display(path):
    return ascii(path) if any(ord(c) < 32 for c in path) else path

print("status:")
records = iter(raw.split(b"\0"))
recent = {}
for n, record in enumerate(records):
    if not record:
        break
    if n == 30:
        print("…（git status 可展开）")
        break
    flags = record[:2].decode("ascii")
    path = os.fsdecode(record[3:])
    if "R" in flags or "C" in flags:
        old = os.fsdecode(next(records))
        print(f"{flags} {display(old)} -> {display(path)}")
    else:
        print(f"{flags} {display(path)}")
    before = sample(path)
    if before and abs(time.time_ns() - before[0]) <= 10_000_000_000:
        recent[path] = before
if recent:
    time.sleep(0.25)
    for path, before in recent.items():
        if sample(path) != before:
            print(f"[WARN_BG_ACTIVE] 采样期间文件继续变化，请核查：{display(path)}")
            break
PY
  then return 0; fi
  status_text="$(git -C "$repo" status --short)" || return 1
  printf 'status: %s\n' "${status_text:-clean}" | sed -n '1,31p'
  say "write_probe: unavailable（结合已知后台命令核查）"
}

# Restrict checkpoint lookup to this working directory. Older v2 checkpoints
# already contain repo_path, including those whose repo_rel was incorrectly ".".
anchor_here() {
  local path
  path="$(kv "$1" repo_path || true)"
  if [ -n "$path" ]; then
    [ "$path" = "$ANCHOR_PATH" ]
  else
    [ -z "$BOUND_ID" ] && [ "${REPO:-}" = "${ORIGIN_REPO:-}" ] &&
      grep -qxF "repo_rel: ${REPO_REL:-.}" "$1"
  fi
}

validate_id() {
  case "$1" in .|..|*/*|*'\'*) die "无效任务 ID" ;; esac
}

select_anchors() {
  local id="$1" f
  MATCHES=()
  ANCHOR_PATH="$(wp "${REPO:-$PWD}")"
  if [ -n "$BOUND_ID" ] && [ -n "$id" ] && [ "$id" != "$BOUND_ID" ]; then
    gap "此工作树绑定任务 $BOUND_ID"
  fi
  id="${id:-$BOUND_ID}"
  if [ -n "$id" ]; then
    validate_id "$id"
    f="$CKPT/$id.md"
    if [ -f "$f" ]; then
      anchor_here "$f" || gap "任务 $id 属于其他工作现场"
      MATCHES+=("$f")
    fi
  else
    for f in "$CKPT"/*.md; do
      [ -f "$f" ] || continue
      if anchor_here "$f"; then MATCHES+=("$f"); fi
    done
  fi
  return 0
}

cmd_init() {
  local workspace="" data_home="${SKEIN_DATA_HOME:-}" init_git=0 with_trae=0 adopt_existing=0 update_rules=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --workspace)      [ $# -ge 2 ] || die "缺 --workspace"; workspace="$2"; shift 2 ;;
      --data)           [ $# -ge 2 ] || die "缺 --data"; data_home="$2"; shift 2 ;;
      --git-init)       init_git=1; shift ;;
      --trae)           with_trae=1; shift ;;
      --adopt-existing) adopt_existing=1; shift ;;
      --update-rules)   update_rules=1; shift ;;
      -h|--help)
        cat <<'EOF'
用法：skein-cli init [--workspace <目录>] [--data <数据家>] [--git-init] [--trae] [--adopt-existing] [--update-rules]
  --workspace       工作区根目录（默认当前目录）
  --data            私有数据目录根（默认 ~/skein-data 或 $SKEIN_DATA_HOME）
  --git-init        若工作区根尚非 Git 仓且内部无子仓，则自动执行 git init
  --trae            额外生成 TRAE CN 项目规则 .trae/rules/project_rules.md
  --adopt-existing  就地收编已有老数据目录（默认保留 AGENTS.md 原有 skein-rules 块不覆盖）
  --update-rules    显式替换 AGENTS.md 中已有的 skein-rules 块（替换前自动备份到 backups/）
EOF
        exit 0 ;;
      *) die "未知参数：$1" ;;
    esac
  done

  [ -n "$workspace" ] || workspace="$(pwd)"
  [ -d "$workspace" ] || gap "目录不存在：$workspace"
  local scope name
  scope="$(cd "$workspace" && pwd -P)"
  name="$(basename "$scope")"

  local nested=""
  while IFS= read -r -d '' f; do nested="${nested}${f}"$'\n'; done < <(
    find "$scope" -mindepth 2 \
      \( -name .git -o -name node_modules -o -name .venv -o -name venv -o -name dist -o -name build -o -name target \) -prune -o \
      -name AGENTS.local.md -type f -print0 2>/dev/null || true
  )
  if [ -n "$nested" ]; then
    printf '发现子目录存在 AGENTS.local.md（会遮蔽工作区路由）：\n%s' "$nested" >&2
    gap "请先与用户确认子路由去留，本命令不自动删除"
  fi

  [ -n "$data_home" ] || data_home="$HOME/skein-data"
  mkdir -p "$data_home" || gap "无法创建数据家：$data_home"
  data_home="$(cd "$data_home" && pwd -P)"
  if git -C "$data_home" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    gap "数据家 $(wp "$data_home") 位于 Git 工作树内，私有数据可能被提交"
  fi

  local d="$data_home/$name"
  local marker="$d/.skein-scope"
  if [ -f "$marker" ]; then
    local owner
    owner="$(head -n 1 "$marker" | tr -d '\r')"
    if [ "$owner" != "$(wp "$scope")" ] && [ "$owner" != "$scope" ]; then
      gap "$(wp "$d") 归属于 $owner，而非 $(wp "$scope")。请换用 --data"
    fi
  elif [ -d "$d" ] && [ -n "$(find "$d" -mindepth 1 -print -quit 2>/dev/null)" ]; then
    if [ "$adopt_existing" -eq 1 ]; then
      say "按 --adopt-existing 收编已有数据目录：$(wp "$d")（保留全部旧数据）"
    else
      gap "$(wp "$d") 非空但缺少 .skein-scope 归属标记；若确认是本工作区老库请加 --adopt-existing"
    fi
  fi

  mkdir -p "$d/checkpoints/done" "$d/worktrees" "$d/board" "$d/backups"
  mkdir -p "$d/kb/facts/projects" "$d/kb/decisions" "$d/kb/runbooks" "$d/kb/proposals" "$d/kb/archive"
  [ -f "$marker" ] || printf '%s\n' "$(wp "$scope")" > "$marker"

  local local_file="$scope/AGENTS.local.md"
  if [ ! -f "$local_file" ]; then
    cat > "$local_file" <<EOF
# Skein 本机路由 · $name

> 本文件含本机绝对路径，永不提交进 Git。换目录时只改此处。

scope: $(wp "$scope")
data_dir: $(wp "$d")
checkpoints: $(wp "$d")/checkpoints
kb: $(wp "$d")/kb
board: $(wp "$d")/board
worktree_root: $(wp "$d")/worktrees
# 可选：未来接入跨项目个人知识库时取消注释
# global_kb: /path/to/personal-kb
EOF
    say "已生成路由：$(wp "$local_file")"
  else
    say "沿用已有路由：$(wp "$local_file")"
  fi

  local agents_md="$scope/AGENTS.md"
  local block_tmp="$scope/.skein-rules.$$.tmp"
  cat > "$block_tmp" <<'EOF'
<!-- skein-rules -->
## Skein v2 工作纪律

- 一次可完成、易于重做且没有待交接决定的小改动，可直接处理，零次 Skein 专用调用。其余可能留下半成品的任务，首次实质修改或启动长耗时操作前，运行 `skein-cli mark --goal "<目标>" --next "<下一步>"` 留最小锚点。
- 目标/约束变更、做出关键决策或排除某方案时，运行 `skein-cli note --type <goal|decision|constraint|excluded|hypothesis|next> "<一句话>"`。
- 换助手、新会话或用户说「接手」时，运行 `skein-cli resume`（单未完任务直接恢复，多任务先问用户）；同会话说「继续」不触发接手。
- 路径统一从 `AGENTS.local.md` 读取；缺键停手报 `[HANDOFF_GAP]`。
<!-- /skein-rules -->
EOF
  local agents_existed=0
  [ -f "$agents_md" ] && agents_existed=1
  if [ "$agents_existed" -eq 0 ]; then
    printf '# 工作区规则 — %s\n\n' "$name" > "$agents_md"
  fi
  if grep -q '<!-- skein-rules -->' "$agents_md"; then
    if [ "$update_rules" -eq 1 ]; then
      local bak="$d/backups/AGENTS.md.$(date '+%Y%m%d-%H%M%S').bak"
      cp "$agents_md" "$bak"
      BLOCK_FILE="$block_tmp" awk '
        BEGIN { while ((getline line < ENVIRON["BLOCK_FILE"]) > 0) blk = blk line ORS }
        /<!-- skein-rules -->/ { printf "%s", blk; skip = 1; next }
        /<!-- \/skein-rules -->/ { skip = 0; next }
        !skip { print }
      ' "$agents_md" > "$agents_md.skein.$$" && mv -f "$agents_md.skein.$$" "$agents_md"
      say "已更新 AGENTS.md 的 skein-rules 块（原文件已备份至 $(wp "$bak")）"
    else
      say "保留已有 AGENTS.md 中的 skein-rules 块（未覆盖；如需替换请加 --update-rules）"
    fi
  else
    if [ "$agents_existed" -eq 1 ]; then
      local bak="$d/backups/AGENTS.md.$(date '+%Y%m%d-%H%M%S').bak"
      cp "$agents_md" "$bak"
      say "已备份原 AGENTS.md 至 $(wp "$bak")"
    fi
    printf '\n' >> "$agents_md"
    cat "$block_tmp" >> "$agents_md"
    say "已向 AGENTS.md 追加 skein-rules 块：$(wp "$agents_md")"
  fi

  if [ "$with_trae" -eq 1 ] || [ -d "$scope/.trae" ]; then
    mkdir -p "$scope/.trae/rules"
    local trae_rule="$scope/.trae/rules/project_rules.md"
    if [ ! -f "$trae_rule" ]; then
      printf '# TRAE 项目协作规则 — %s\n\n' "$name" > "$trae_rule"
      cat "$block_tmp" >> "$trae_rule"
      say "已生成 TRAE 规则：$(wp "$trae_rule")"
    fi
  fi
  rm -f "$block_tmp"

  if [ -e "$scope/.git" ]; then
    if git -C "$scope" ls-files --error-unmatch AGENTS.local.md >/dev/null 2>&1; then
      gap "AGENTS.local.md 已被 git 跟踪，请先执行 git rm --cached AGENTS.local.md"
    fi
    local gi="$scope/.gitignore"
    grep -qxF '/AGENTS.local.md' "$gi" 2>/dev/null || printf '\n/AGENTS.local.md\n' >> "$gi"
  fi

  local kb="$d/kb"
  [ -e "$kb/.git" ] || git -C "$kb" init -q
  if [ -n "$(git -C "$kb" remote 2>/dev/null || true)" ]; then
    gap "知识库 $(wp "$kb") 配置了远程仓库，违反本地离线约束"
  fi
  local generated=()
  if [ ! -f "$kb/INDEX.md" ]; then
    generated+=(INDEX.md)
    cat > "$kb/INDEX.md" <<EOF
# $name · 知识库索引

> 仅作目录导航，禁止全量加载知识库正文。

| 目录 | 用途 |
|---|---|
| \`facts/projects/\` | 各活跃子项目最小档案（≤2KB/份，按需只读当前子项目） |
| \`facts/\` | 环境、接口与已验证硬事实 |
| \`decisions/\` | 关键架构与方案决策及理由 |
| \`runbooks/\` | 可复用操作手册 |
| \`proposals/\` | 并发协作时的只读方建议与待合并提案 |
| \`archive/\` | 已废弃历史记录 |
EOF
  fi

  local repo_list=""
  if is_repo_root "$scope"; then
    repo_list="."
  fi
  local sub cand rel
  for sub in "$scope"/*/; do
    [ -d "$sub" ] || continue
    skip_dir "$(basename "${sub%/}")" && continue
    for cand in "$sub" "$sub"*/; do
      [ -d "$cand" ] || continue
      skip_dir "$(basename "${cand%/}")" && continue
      is_repo_root "$cand" || continue
      rel="${cand#"$scope"/}"; rel="${rel%/}"
      case $'\n'"$repo_list"$'\n' in *$'\n'"$rel"$'\n'*) continue ;; esac
      repo_list="${repo_list}${repo_list:+$'\n'}${rel}"
    done
  done

  if [ -z "$repo_list" ] && [ "$init_git" -eq 1 ]; then
    git -C "$scope" init -q
    grep -qxF '/AGENTS.local.md' "$scope/.gitignore" 2>/dev/null || printf '\n/AGENTS.local.md\n' >> "$scope/.gitignore"
    repo_list="."
    say "已为纯文档/非 Git 工作区初始化 Git 仓"
  fi

  local idx="$kb/facts/projects/INDEX.md"
  if [ -n "$repo_list" ]; then
    local tmp="$idx.$$.tmp"
    {
      printf '# 项目档案索引\n\n'
      printf '> 接手时只读当前子项目对应档案，禁止全读。\n\n'
      printf '| 仓 | 相对路径 | 档案 | 状态 |\n'
      printf '|---|---|---|---|\n'
      while IFS= read -r rel; do
        [ -n "$rel" ] || continue
        local base file st
        if [ "$rel" = "." ]; then base="$name"; else base="$(basename "$rel")"; fi
        file="${base}.md"
        st="TODO"
        if [ -f "$kb/facts/projects/$file" ]; then
          st="$(sed -n 's/^- 状态：[[:space:]]*//p' "$kb/facts/projects/$file" | head -n 1 | tr -d '\r')"
          [ -n "$st" ] || st="PARTIAL"
        fi
        printf '| `%s` | `%s` | `%s` | %s |\n' "$base" "$rel" "$file" "$st"
      done <<< "$repo_list"
    } > "$tmp"
    mv -f "$tmp" "$idx"
    generated+=(facts/projects/INDEX.md)
  fi

  local map_written=0
  cmd_map --workspace "$scope" --kb "$kb" >/dev/null
  if [ "$map_written" -eq 1 ]; then
    generated+=(facts/workspace-map.md)
  fi
  if [ "${#generated[@]}" -gt 0 ]; then
    git -C "$kb" -c core.autocrlf=false add -- "${generated[@]}"
    if ! git -C "$kb" diff --cached --quiet -- "${generated[@]}"; then
      git -C "$kb" -c core.autocrlf=false -c user.name=skein -c user.email=skein@local \
        commit -q --only -m "kb: init or refresh index" -- "${generated[@]}"
    fi
  fi

  local has_aimem="未安装" has_kanban="未安装" has_qmd="未安装"
  command -v ai-memory >/dev/null 2>&1 && has_aimem="已就绪"
  command -v kanban-md >/dev/null 2>&1 && has_kanban="已就绪"
  command -v qmd >/dev/null 2>&1 && has_qmd="已就绪"

  say "=== Skein v2 建库完成 ==="
  say "路由：$(wp "$local_file")"
  say "数据：$(wp "$d")"
  say "外部工具：ai-memory=$has_aimem | kanban-md=$has_kanban | qmd=$has_qmd"
  say "下一步：为确认纳入范围的活跃子仓写最小档案（≤2KB），然后跑 skein-cli check --strict 验收，建完即卸载 skein-init。"
}

cmd_map() {
  local workspace="" kb="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --workspace) workspace="$2"; shift 2 ;;
      --kb)        kb="$2"; shift 2 ;;
      --force)     force=1; shift ;;
      *) shift ;;
    esac
  done
  [ -n "$workspace" ] || workspace="$(pwd)"
  local scope
  scope="$(cd "$workspace" && pwd -P)"
  if [ -z "$kb" ]; then
    [ -f "$scope/AGENTS.local.md" ] || gap "缺 AGENTS.local.md"
    kb="$(kv "$scope/AGENTS.local.md" kb || true)"
  fi
  [ -d "$kb" ] || gap "知识库目录不存在：$kb"

  local count=0 p base
  for p in "$scope"/*; do
    base="${p##*/}"
    case "$base" in AGENTS.local.md|node_modules|.venv|venv|dist|build|target) continue ;; esac
    [ -e "$p" ] && count=$((count + 1))
  done
  if [ "$count" -lt 3 ] && [ "$force" -ne 1 ]; then
    say "顶层条目少于 3 项，跳过地图生成"
    return 0
  fi

  local out="$kb/facts/workspace-map.md"
  local tmp="$out.$$.tmp"
  {
    printf '# 工作区机械地图\n\n'
    printf '> 生成时间：%s\n\n' "$(date '+%Y-%m-%d %H:%M')"
    printf '| 条目 | 类型 | 最后提交 | 顶层条目数 |\n'
    printf '|---|---|---|---:|\n'
    for p in "$scope"/*; do
      base="${p##*/}"
      case "$base" in AGENTS.local.md|node_modules|.venv|venv|dist|build|target) continue ;; esac
      [ -e "$p" ] || continue
      local kind="文件" last="-" subs="-"
      if [ -d "$p" ]; then
        kind="目录"; subs=0
        for _c in "$p"/*; do subs=$((subs + 1)); done
        if is_repo_root "$p"; then
          kind="git 仓"
          last="$(git -C "$p" log -1 --format=%cs 2>/dev/null || echo '无提交')"
        fi
      fi
      printf '| `%s` | %s | %s | %s |\n' "$base" "$kind" "$last" "$subs"
    done
  } > "$tmp"
  mv -f "$tmp" "$out"
  map_written=1
  say "已更新地图：$(wp "$out")"
}

# Show the newest goal/next. Keep a short window for additive sections;
# omitted records remain accessible in the original anchor via --full.
anchor_view() {
  awk -v mode="$1" '
    /^## [1-6]\. / { section = substr($0, 4, 1) + 0; title[section] = $0; next }
    section && /^- / {
      value = substr($0, 3)
      sub(/^\[[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]\] /, "", value)
      n = ++count[section]
      recent[section, n % 3] = value
    }
    END {
      if (mode == "goal") { print recent[1, count[1] % 3]; exit }
      for (s = 1; s <= 6; s++) {
        print title[s]
        keep = (s == 1 || s == 6) ? 1 : 3
        first = count[s] > keep ? count[s] - keep + 1 : 1
        if (first > 1) print "  （另有 " (first - 1) " 条历史记录，resume --full 查看）"
        for (i = first; i <= count[s]; i++) {
          value = recent[s, i % 3]
          if (length(value) > 240) value = substr(value, 1, 240) "…（--full）"
          print "- " value
        }
      }
    }
  ' "$2"
}

cmd_mark() {
  load_route
  current_repo_info
  local id="" goal="" next="" constraint=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --id)         id="$2"; shift 2 ;;
      --goal)       goal="$2"; shift 2 ;;
      --next)       next="$2"; shift 2 ;;
      --constraint) constraint="$2"; shift 2 ;;
      -h|--help)
        cat <<'EOF'
用法：skein-cli mark --goal "<目标>" --next "<下一步>" [--id <任务ID>] [--constraint "<约束>"]
EOF
        exit 0 ;;
      *) die "未知参数：$1" ;;
    esac
  done
  [ -n "$goal" ] || die "必须提供 --goal"
  [ -n "$next" ] || next="待定"

  mkdir -p "$CKPT"
  select_anchors "$id"
  if [ "${#MATCHES[@]}" -gt 1 ]; then
    gap "当前现场有多个任务，请用 --id 选择已有任务或创建新任务"
  fi
  if [ "${#MATCHES[@]}" -eq 1 ]; then
    local existing="${MATCHES[0]}" previous_goal
    previous_goal="$(anchor_view goal "$existing")"
    if [ "$goal" != "$previous_goal" ]; then
      gap "已有任务 $(basename "$existing" .md) 的目标不同。新任务请指定新 --id，目标变更请用 note --type goal"
    fi
    say "ANCHOR_OK task_id=$(basename "$existing" .md) reused=1（已保留记录，变更用 note）"
    return 0
  fi
  id="${id:-$BOUND_ID}"
  [ -n "$id" ] || id="${REPO_NAME}-$(date '+%Y%m%d-%H%M%S')-$$"

  local target="$CKPT/${id}.md"
  local head_sha="none" branch="none"
  if [ -n "$REPO" ]; then
    head_sha="$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo 'unborn')"
    branch="$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || echo 'unborn')"
  fi

  local tmp="${target}.$$.tmp"
  cat > "$tmp" <<EOF
---
schema_version: 2
task_id: $id
status: ACTIVE
repo_rel: ${REPO_REL:-.}
repo_path: $(wp "${REPO:-$PWD}")
branch: $branch
base_head: $head_sha
updated_at: $(now_iso)
---

## 1. 最后确认的目标
- $goal

## 2. 变更过的约束
- ${constraint:-无}

## 3. 关键决定及理由
- 无

## 4. 已排除的方案
- 无

## 5. 当前待验证假设
- 无

## 6. 下一步
- $next
EOF
  mv -f "$tmp" "$target"
  say "ANCHOR_OK task_id=$id file=$(wp "$target")"
}

cmd_note() {
  load_route
  current_repo_info
  local id="" ntype="decision" text=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --id)   id="$2"; shift 2 ;;
      --type) ntype="$2"; shift 2 ;;
      -h|--help)
        cat <<'EOF'
用法：skein-cli note --type <goal|constraint|decision|excluded|hypothesis|next> [--id <任务ID>] "<内容>"
EOF
        exit 0 ;;
      *) text="${text}${text:+ }$1"; shift ;;
    esac
  done
  [ -n "$text" ] || die "缺少记录内容"

  select_anchors "$id"
  [ "${#MATCHES[@]}" -eq 1 ] || gap "当前现场匹配 ${#MATCHES[@]} 个任务，请用 --id 指定或先 mark"
  local target="${MATCHES[0]}"
  id="$(basename "$target" .md)"

  local heading=""
  case "$ntype" in
    goal)       heading="## 1. 最后确认的目标" ;;
    constraint) heading="## 2. 变更过的约束" ;;
    decision)   heading="## 3. 关键决定及理由" ;;
    excluded)   heading="## 4. 已排除的方案" ;;
    hypothesis) heading="## 5. 当前待验证假设" ;;
    next)       heading="## 6. 下一步" ;;
    *) die "未知 --type：$ntype（可选 goal/constraint/decision/excluded/hypothesis/next）" ;;
  esac

  local ts tmp="${target}.$$.tmp"
  ts="$(date '+%m-%d %H:%M')"
  HEADING="$heading" ENTRY="- [$ts] $text" NOW="$(now_iso)" awk '
    /^updated_at:/ { print "updated_at: " ENVIRON["NOW"]; next }
    $0 == ENVIRON["HEADING"] { print; in_sec = 1; next }
    in_sec && /^- 无$/ { print ENVIRON["ENTRY"]; in_sec = 0; inserted = 1; next }
    in_sec && /^## / { print ENVIRON["ENTRY"]; print ""; print; in_sec = 0; inserted = 1; next }
    { print }
    END { if (in_sec && !inserted) print ENVIRON["ENTRY"] }
  ' "$target" > "$tmp"
  mv -f "$tmp" "$target"
  say "NOTE_OK task_id=$id type=$ntype"
}

cmd_close() {
  load_route
  local id="${1:-}"
  [ -n "$id" ] || die "用法：skein-cli close <task_id>"
  validate_id "$id"
  local bound
  bound="$(kv "$LOCAL" worktree_task_id || true)"
  [ -z "$bound" ] || [ "$bound" = "$id" ] || gap "此工作树绑定任务 $bound"
  local src="$CKPT/${id}.md"
  [ -f "$src" ] || gap "任务不存在：$src"
  mkdir -p "$CKPT/done"
  sed "s/^status: ACTIVE/status: CLOSED/" "$src" > "$CKPT/done/${id}.md"
  rm -f "$src"
  say "CLOSED task_id=$id"
}

cmd_resume() {
  load_route
  current_repo_info
  local id="" full=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --id) id="$2"; shift 2 ;;
      --full) full=1; shift ;;
      *) die "未知参数：$1" ;;
    esac
  done

  say "=== SKEIN RESUME PACKET ==="
  say "scope: $(wp "$SCOPE")"
  say "repo: ${REPO_REL:-.} ($(wp "${REPO:-$PWD}"))"

  if [ -n "$REPO" ]; then
    local bg
    bg="$(check_bg_writers "$REPO")" || gap "无法核对当前工作树的 Git 锁"
    if [ -n "$bg" ]; then
      say ""
      say "[WARN_BG_ACTIVE] 检测到当前工作树的 Git 锁，请先核查进程和产物再决定是否等待："
      printf '%s\n' "$bg"
    else
      say "git_index_lock: none（普通后台命令须结合已知进程及产物核查）"
    fi
  fi

  local brief="$KB/facts/projects/${REPO_NAME}.md"
  say ""
  if [ -f "$brief" ]; then
    say "--- PROJECT_BRIEF ($(wp "$brief")) ---"
    cat "$brief"
  else
    say "--- PROJECT_BRIEF: MISSING (当前子仓尚未建最小档案；老库请跑 skein-cli init --adopt-existing 后补档) ---"
  fi

  say ""
  say "--- GIT_LIVE ---"
  if [ -n "$REPO" ]; then
    say "branch: $(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || echo unborn)"
    say "head: $(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo unborn)"
    local packet
    packet="$(git_live_status "$REPO")" || gap "无法核对 Git 工作树状态"
    printf '%s\n' "$packet"
    if [ -n "$bg" ] || [[ "$packet" == *"[WARN_BG_ACTIVE]"* ]]; then
      # Command-line matches are clues, not proof of ownership. Only show PID/name.
      ps -eo pid=,comm=,args= 2>/dev/null | awk -v root="$REPO" -v native="$(wp "$REPO")" '
        (index($0,root) || index($0,native)) && $2 !~ /^(awk|ps|bash|sh)$/ &&
        !/skein-cli/ { if (++n <= 5) print "process_hint:", $1, $2 }
      ' || true
    fi
    say "recent_commits:"
    git -C "$REPO" log -n 5 --oneline 2>/dev/null || say "(尚无提交)"
  else
    say "not_a_git_repo"
  fi

  say ""
  select_anchors "$id"
  local f
  if [ -n "$id" ] && [ "${#MATCHES[@]}" -eq 0 ]; then gap "指定的任务不存在：$id"; fi
  if [ "${#MATCHES[@]}" -eq 0 ]; then
    say "--- TASK_ANCHOR: NONE (无显式任务锚点，请结合 ai-memory/Git 现场重建) ---"
  elif [ "${#MATCHES[@]}" -eq 1 ]; then
    say "--- TASK_ANCHOR: SINGLE ($(basename "${MATCHES[0]}" .md)) ---"
    if [ "$full" -eq 1 ]; then cat "${MATCHES[0]}"; else anchor_view compact "${MATCHES[0]}"; fi
  else
    say "--- TASK_ANCHOR: MULTIPLE (${#MATCHES[@]} 个未完任务，请先列清单问用户选哪项) ---"
    for f in "${MATCHES[@]}"; do
      local tid g
      tid="$(basename "$f" .md)"
      g="$(anchor_view goal "$f")"
      say "- $tid | $g"
    done
  fi

  # 外部自动留痕读取：调用经过核验的 `ai-memory recent`（在项目 cwd 下执行，绝不静默吞错）
  say ""
  if command -v ai-memory >/dev/null 2>&1; then
    say "--- EXTERNAL_CAPTURE: ai-memory (recent) ---"
    local aim_out="" aim_rc=0
    aim_out="$(cd "${REPO:-$PWD}" && ai-memory recent 2>&1)" || aim_rc=$?
    if [ "$aim_rc" -eq 0 ] && [ -n "$aim_out" ]; then
      printf '%s\n' "$aim_out" | sed -n '1,30p'
    elif [ "$aim_rc" -eq 0 ]; then
      say "(ai-memory 正常响应，当前项目暂无近期捕获页)"
    elif printf '%s' "$aim_out" | grep -qiE '404 Not Found|not found in workspace'; then
      say "(ai-memory 服务在线，当前项目尚未产生首次捕获记录)"
    else
      say "[WARN_EXTERNAL_CAPTURE] ai-memory recent 执行失败（exit $aim_rc）："
      printf '%s\n' "$aim_out" | grep -iE 'error|fail|refused|denied' | head -n 5 || printf '%s\n' "$aim_out" | tail -n 5
    fi
  elif command -v cass >/dev/null 2>&1; then
    say "--- EXTERNAL_CAPTURE: cass (fallback detected) ---"
    say "如需回看中断前未落盘的最后几轮探索，可按需运行 cass 搜索当前目录近期会话。"
  else
    say "--- EXTERNAL_CAPTURE: none (仅依靠任务锚点 + Git 现场) ---"
  fi

  if command -v kanban-md >/dev/null 2>&1 && [ -f "$BOARD/config.yml" ]; then
    say ""
    say "--- KANBAN_COMPACT ---"
    kanban-md list --dir "$BOARD" --compact 2>/dev/null | head -n 20 || true
  fi
}

cmd_wt_add() {
  load_route
  current_repo_info
  [ -n "$REPO" ] || gap "当前目录不在 Git 仓内，无法创建 worktree"
  local task="${1:-}"
  [ -n "$task" ] || die "用法：skein-cli wt-add <task-slug>"
  local wt_base="$WT_ROOT/${REPO_NAME}-$(printf '%s' "$ORIGIN_REPO" | hash8)"
  local wt_dir="$wt_base/$task"
  local branch="feat/${task}"
  mkdir -p "$wt_base"
  git -C "$REPO" worktree add -b "$branch" "$wt_dir" HEAD
  local task_id
  task_id="wt-$(printf '%s\n%s' "$ORIGIN_REPO" "$task" | hash8)-${task##*/}"
  { sed '/^worktree_task_id:/d' "$LOCAL"; printf '\nworktree_task_id: %s\n' "$task_id"; } > "$wt_dir/AGENTS.local.md"
  local ex
  ex="$(git -C "$REPO" rev-parse --git-path info/exclude 2>/dev/null || true)"
  if [ -n "$ex" ]; then
    case "$ex" in /*|[A-Za-z]:/*) ;; *) ex="$REPO/$ex" ;; esac
    mkdir -p "$(dirname "$ex")"
    grep -qxF '/AGENTS.local.md' "$ex" 2>/dev/null || printf '\n/AGENTS.local.md\n' >> "$ex"
  fi
  say "WT_READY dir=$(wp "$wt_dir") branch=$branch task_id=$task_id"
}

cmd_wt_clean() {
  load_route
  current_repo_info
  [ -n "$REPO" ] || gap "当前目录不在 Git 仓内"
  local task="${1:-}"
  [ -n "$task" ] || die "用法：skein-cli wt-clean <task-slug>"
  local wt_dir="$WT_ROOT/${REPO_NAME}-$(printf '%s' "$ORIGIN_REPO" | hash8)/$task"
  [ -d "$wt_dir" ] || gap "worktree 目录不存在：$wt_dir"
  local dirty
  dirty="$(git -C "$wt_dir" status --porcelain)" || gap "无法核查工作树，保留原目录"
  if [ -n "$dirty" ]; then
    gap "worktree 存在未提交改动，拒绝清理：$wt_dir"
  fi
  git -C "$REPO" worktree remove "$wt_dir"
  say "WT_REMOVED dir=$(wp "$wt_dir")"
  say "提示：并行协作结束后，请手动通过 skills-manager 卸载 agent-collab。"
}

cmd_check() {
  local strict=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --strict) strict=1; shift ;;
      *) shift ;;
    esac
  done

  load_route
  current_repo_info
  say "=== Skein v2 体检 ==="
  say "scope: $(wp "$SCOPE")"
  say "repo:  ${REPO_REL:-.} ($REPO_NAME)"

  local fail=0 warn=0
  for k in scope data_dir checkpoints kb board worktree_root; do
    if kv "$LOCAL" "$k" >/dev/null 2>&1; then
      say "  [OK]   路由键 $k"
    else
      say "  [FAIL] 缺少路由键 $k"; fail=1
    fi
  done

  if [ -n "$DATA_DIR" ] && [ -f "$DATA_DIR/.skein-scope" ]; then
    say "  [OK]   数据目录归属标记 .skein-scope 存在"
  else
    say "  [WARN] 缺少 .skein-scope（老库请跑 skein-cli init --adopt-existing）"; warn=1
  fi

  if [ -e "$SCOPE/.git" ]; then
    if git -C "$SCOPE" check-ignore -q AGENTS.local.md 2>/dev/null; then
      say "  [OK]   AGENTS.local.md 已加入 Git 忽略"
    else
      say "  [FAIL] AGENTS.local.md 未被 Git 忽略"; fail=1
    fi
  fi

  if [ -z "$(git -C "$KB" remote 2>/dev/null || true)" ]; then
    say "  [OK]   知识库无远程配置（纯本地离线）"
  else
    say "  [FAIL] 知识库存在远程仓库"; fail=1
  fi

  # 校验当前子项目最小档案（避免 check 全绿但 resume 缺 PROJECT_BRIEF）
  local brief="$KB/facts/projects/${REPO_NAME}.md"
  if [ -f "$brief" ]; then
    local bst
    bst="$(sed -n 's/^- 状态：[[:space:]]*//p' "$brief" | head -n 1 | tr -d '\r')"
    if [ "$bst" = "READY" ]; then
      say "  [OK]   当前子项目最小档案就绪（$(wp "$brief")）"
    else
      say "  [WARN] 当前子项目最小档案状态为 ${bst:-未知}（非 READY）：$(wp "$brief")"; warn=1
    fi
  else
    say "  [WARN] 当前子项目缺少最小档案（$(wp "$brief")），resume 将报 PROJECT_BRIEF: MISSING"; warn=1
  fi

  # 校验外部捕获工具（ai-memory）实际可执行性
  if command -v ai-memory >/dev/null 2>&1; then
    local aim_out="" aim_rc=0
    aim_out="$(cd "${REPO:-$PWD}" && ai-memory recent 2>&1)" || aim_rc=$?
    if [ "$aim_rc" -eq 0 ]; then
      say "  [OK]   外部捕获 ai-memory recent 正常响应"
    elif printf '%s' "$aim_out" | grep -qiE '404 Not Found|not found in workspace'; then
      say "  [INFO] 外部捕获 ai-memory 服务在线，当前项目尚未产生首次捕获记录（新项目正常）"
    else
      local err_line
      err_line="$(printf '%s\n' "$aim_out" | grep -iE 'error|fail|refused|denied' | head -n 1 || printf '%s\n' "$aim_out" | tail -n 1)"
      say "  [FAIL] 外部捕获 ai-memory recent 异常（exit $aim_rc）：$err_line"; fail=1
    fi
  else
    say "  [INFO] 未检测到 ai-memory（仅使用任务锚点 + Git 现场）"
  fi

  if [ "$strict" -eq 1 ] && [ "$warn" -ne 0 ]; then
    say "严格模式（--strict）未通过：请先消除上述 [WARN] 项。"
    exit 1
  fi
  exit "$fail"
}

SUB="${1:-help}"
shift || true
case "$SUB" in
  init)     cmd_init "$@" ;;
  map)      cmd_map "$@" ;;
  mark)     cmd_mark "$@" ;;
  note)     cmd_note "$@" ;;
  close)    cmd_close "$@" ;;
  resume)   cmd_resume "$@" ;;
  wt-add)   cmd_wt_add "$@" ;;
  wt-clean) cmd_wt_clean "$@" ;;
  check)    cmd_check "$@" ;;
  -v|--version) say "skein-cli $VERSION" ;;
  -h|--help|help)
    cat <<'EOF'
skein-cli v2.0.6 — Skein 机械操作单命令封装层

子命令：
  init       初始化工作区、路由、离线知识库与档案索引（--trae 生成 TRAE 规则；--adopt-existing 收编老库）
  map        刷新工作区顶层机械地图
  mark       写前最小留痕（创建/复用任务锚点，更新用 note）
  note       追加 1 行语义锚点（goal/constraint/decision/excluded/hypothesis/next）
  close      关闭并归档已完成任务
  resume     默认简报，--full 展开完整任务锚点。输出接手上下文包（档案+Git现场+锚点+后台写入探测+ai-memory recent）
  wt-add     为并行子任务建独立 worktree 并复制路由
  wt-clean   合并后安全清理 worktree（拒绝强制覆盖脏树）
  check      体检路由、归属标记、最小档案与 ai-memory 连通性（--strict 将 WARN 视为失败）
EOF
    ;;
  *) die "未知子命令：$SUB（运行 skein-cli --help 查看用法）" ;;
esac
